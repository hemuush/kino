# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ───────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing ────────────────────────────────────────────
/coverage

# ─── Next.js ────────────────────────────────────────────
/.next/
/out/

# ─── Production build ───────────────────────────────────
/build

# ─── Environment Variables ──────────────────────────────
# ⚠ Never commit secrets
.env*

# ─── TypeScript build artifacts ─────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Vercel ─────────────────────────────────────────────
.vercel/

# ─── Misc / OS ──────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ─── Debug logs ─────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── IDE / Editor ───────────────────────────────────────
.vscode/
.idea/

# ─── AI agent directories ───────────────────────────────
.antigravitycli/
unused/

# ─── One-off scripts (not needed in production) ─────────
fix_colors.js

# ─── Screenshots / temp assets ──────────────────────────
Screenshot*.png
Screenshot*.jpg
